---
import { t, localeRoot, type Locale } from '../i18n';
import { REPO_URL } from '../lib/site-config.mjs';
import { docsEntryPath } from '../lib/docs';

interface Props {
  locale: Locale;
  otherPath: string;
}

const { locale, otherPath } = Astro.props;
const dict = t(locale);
const root = localeRoot(locale);
const docsPath = await docsEntryPath(locale);
---

<header class="site-header">
  <div class="container inner">
    <a class="wordmark" href={root}>pfpdf</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label class="hamburger" for="nav-toggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>
    <nav class="nav" aria-label="Site">
      <a href={`${root}gallery/`}>{dict.nav.gallery}</a>
      <a href={docsPath}>{dict.nav.docs}</a>
      <a href={REPO_URL} rel="external">{dict.nav.github}</a>
      <a class="lang-switch" href={otherPath} title={dict.langSwitch.title} rel="alternate">
        {dict.langSwitch.label}
      </a>
      <button type="button" id="theme-toggle" aria-label={dict.theme.toggle} title={dict.theme.toggle}>
        <span class="theme-icon" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle').addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme === 'dark';
    if (dark) {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = 'dark';
    }
    localStorage.setItem('pfpdf-theme', dark ? 'light' : 'dark');
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
  }

  .wordmark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .wordmark::after {
    content: '_';
    color: var(--accent);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .nav a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav a:hover {
    color: var(--accent);
  }

  .lang-switch {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.7rem;
    font-size: 0.85rem;
  }

  #theme-toggle {
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .theme-icon {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: inset -0.28rem -0.28rem 0 0 var(--bg);
  }

  .nav-toggle,
  .hamburger {
    display: none;
  }

  @media (max-width: 40rem) {
    .hamburger {
      display: grid;
      gap: 0.28rem;
      cursor: pointer;
      padding: 0.4rem;
    }

    .hamburger span {
      display: block;
      width: 1.2rem;
      height: 2px;
      background: var(--ink);
    }

    .nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: flex-start;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.25rem;
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }
  }
</style>
