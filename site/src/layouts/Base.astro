---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, alternatePath, type Locale } from '../i18n';
import { SITE_URL } from '../lib/site-config.mjs';

interface Props {
  locale: Locale;
  path: string; // root-relative path of this page, e.g. "/ja/gallery/pfn/"
  title?: string;
  description?: string;
}

const { locale, path } = Astro.props;
const dict = t(locale);
const title = Astro.props.title ?? `${dict.siteName} — ${dict.tagline}`;
const description = Astro.props.description ?? dict.description;
const absolute = (rootRelative: string) => new URL(rootRelative.replace(/^\//, ''), SITE_URL).href;
const enPath = locale === 'en' ? path : alternatePath('ja', path);
const jaPath = locale === 'ja' ? path : alternatePath('en', path);
const otherPath = locale === 'ja' ? enPath : jaPath;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={absolute(path)} />
    <link rel="alternate" hreflang="en" href={absolute(enPath)} />
    <link rel="alternate" hreflang="ja" href={absolute(jaPath)} />
    <link rel="alternate" hreflang="x-default" href={absolute(enPath)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(path)} />
    <meta property="og:image" content={absolute('/ogp.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('pfpdf-theme');
        const dark = stored === 'dark'
          || (stored === null && matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.dataset.theme = 'dark';
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} otherPath={otherPath} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
