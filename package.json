{
  "name": "pfpdf",
  "version": "0.1.0",
  "description": "Convert GitHub Flavored Markdown documents into print-quality PDF via Vivliostyle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pfnet-research/pfpdf.git"
  },
  "homepage": "https://github.com/pfnet-research/pfpdf#readme",
  "bugs": "https://github.com/pfnet-research/pfpdf/issues",
  "type": "module",
  "bin": {
    "pfpdf": "dist/launcher.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/*.js",
    "resources",
    "README.md",
    "README.ja.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md",
    "npm-shrinkwrap.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-resources.mjs",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit && oxlint src && node scripts/check-doc-policy.mjs && node scripts/check-package-policy.mjs",
    "prepack": "npm run build",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@citation-js/plugin-csl": "0.8.2",
    "@csstools/css-tokenizer": "3.0.4",
    "@puppeteer/browsers": "3.0.4",
    "@vivliostyle/cli": "11.1.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "isomorphic-mermaid": "0.1.1",
    "js-yaml": "4.3.1",
    "lowlight": "3.3.0",
    "mathjax-full": "3.2.1",
    "mermaid": "11.16.1",
    "pdf-lib": "1.17.1",
    "rehype-raw": "7.0.0",
    "remark-cjk-friendly": "2.3.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
